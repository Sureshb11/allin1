generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                 String               @id @default(cuid())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  email              String               @unique
  phone              String?              @unique
  passwordHash       String
  firstName          String
  lastName           String
  avatarUrl          String?
  bio                String?
  plan               String               @default("free")
  proUntil           DateTime?
  city               String?
  country            String?
  district           String?
  pincode            String?
  state              String?
  coverUrl           String?
  dateOfBirth        String?
  height             String?
  weight             String?
  isAdmin            Boolean              @default(false)
  chatRooms          ChatMember[]
  chatMessages       ChatMessage[]
  notifications      Notification[]
  players            Player[]
  products           Product[]
  ownedTeams         Team[]               @relation("ownedTeams")
  teamFollows        TeamFollow[]
  badges             UserBadge[]
  sports             UserSport[]
  devices            DeviceToken[]
  adminVerifications GroundVerification[]
}

// A device's FCM registration token — one row per install per user, so a push
// reaches every device someone is signed in on. Tokens are rotated by FCM, and
// dead ones are pruned when a send reports them unregistered.
model DeviceToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     String   @unique
  platform  String   @default("android")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  sport     String
  isPrimary Boolean  @default(false)
  role      String?
  skill     String?
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, sport])
  @@index([sport])
}

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  data      Json?
  user      User     @relation(fields: [userId], references: [id])

  // The bell screen reads "my notifications, newest first" — without this the
  // lookup is a sequential scan over every row in the table.
  @@index([userId, createdAt])
  // Unread badge counts.
  @@index([userId, read])
}

model Team {
  id                     String                  @id @default(cuid())
  name                   String
  // A short code for where the full name will not fit — a scorecard column, a
  // fixture list, a standings row. "D-Vigo-S XI" is eleven characters in a slot
  // built for four.
  shortName              String?
  website                String?
  city                   String?
  logoUrl                String?
  achievements           String?
  bio                    String?
  colors                 String?
  country                String?
  foundedYear            Int?
  homeGround             String?
  state                  String?
  sport                  String                  @default("cricket")
  ownerId                String?
  coverUrl               String?
  awards                 Json?
  chatRoomId             String?
  battingInnings         Inning[]                @relation("battingTeam")
  bowlingInnings         Inning[]                @relation("bowlingTeam")
  team1Matches           Match[]                 @relation("team1")
  team2Matches           Match[]                 @relation("team2")
  matchPlayers           MatchPlayer[]
  players                Player[]
  owner                  User?                   @relation("ownedTeams", fields: [ownerId], references: [id])
  followers              TeamFollow[]
  tournamentTeams        TournamentTeam[]
  tournamentParticipants TournamentParticipant[]

  @@index([sport])
  @@index([ownerId])
}

model TeamJoinRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String
  userId    String
  status    String   @default("pending")
  note      String?

  @@unique([teamId, userId])
  @@index([teamId, status])
  @@index([userId])
}

model TeamFollow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model Player {
  id                     String                     @id @default(cuid())
  name                   String
  role                   String
  teamId                 String?
  stats                  Json?
  sport                  String                     @default("cricket")
  userId                 String?
  isAdmin                Boolean                    @default(false)
  jerseyNumber           Int?
  isCaptain              Boolean                    @default(false)
  isViceCaptain          Boolean                    @default(false)
  // How they bat and bowl. The Edit Player screen has asked for both as free
  // text since it was written and never sent either — there was nowhere to put
  // them. Nullable: an existing player has said nothing yet.
  battingStyle           String?
  bowlingStyle           String?
  ballsFaced             Ball[]                     @relation("facingBatter")
  ballsBowled            Ball[]                     @relation("ballBowler")
  ballsNonStriker        Ball[]                     @relation("nonStriker")
  matchPlayers           MatchPlayer[]
  oversBowled            Over[]
  historicalStats        HistoricalStatSubmission[]
  team                   Team?                      @relation(fields: [teamId], references: [id])
  user                   User?                      @relation(fields: [userId], references: [id])
  player1Matches         Match[]                    @relation("player1")
  player2Matches         Match[]                    @relation("player2")
  tournamentParticipants TournamentParticipant[]

  @@index([sport])
  @@index([userId])
  @@index([teamId])
}

model HistoricalStatSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  playerId  String
  status    String   @default("pending") // pending, approved, rejected
  adminNote String?
  data      Json
  imageUrls String[]
  player    Player   @relation(fields: [playerId], references: [id])

  @@index([playerId])
  @@index([status])
}

model Match {
  id                      String             @id @default(cuid())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  team1Id                 String?
  team2Id                 String?
  player1Id               String?
  player2Id               String?
  participantType         String             @default("TEAM") // TEAM or PLAYER
  status                  String
  score1                  String?
  score2                  String?
  venue                   String?
  matchType               String?
  startTime               DateTime?
  currentInnings          Int                @default(1)
  overs                   Int?
  tossDecision            String?
  tossWinnerId            String?
  result                  String?
  sport                   String             @default("cricket")
  ballType                String?
  scorerId                String?
  createdBy               String?
  // Is the scorer capturing where each ball went? Chosen at the toss, per match,
  // and false unless someone opted in — scoring a game must never get slower
  // because a feature exists. Deliberately NOT a global setting: the same scorer
  // will want it for a club final and not for a Sunday friendly.
  ballIntelligenceEnabled Boolean            @default(false)
  innings                 Inning[]
  team1                   Team?              @relation("team1", fields: [team1Id], references: [id])
  team2                   Team?              @relation("team2", fields: [team2Id], references: [id])
  player1                 Player?            @relation("player1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2                 Player?            @relation("player2", fields: [player2Id], references: [id], onDelete: SetNull)
  squads                  MatchPlayer[]
  sportEvents             SportEvent[]
  broadcasts              BroadcastSession[]
  matchRoles              MatchRole[]

  @@index([sport, status])
  @@index([startTime])
  @@index([createdBy])
  @@index([player1Id])
  @@index([player2Id])
  @@index([participantType])
}

model SportEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  matchId   String
  sport     String
  teamId    String
  playerId  String?
  eventType String
  value     Int      @default(1)
  period    String?
  periodNum Int?
  metadata  Json?
  match     Match    @relation(fields: [matchId], references: [id])

  @@index([matchId])
  @@index([sport])
}

model MatchPlayer {
  id            String  @id @default(cuid())
  matchId       String
  teamId        String
  playerId      String
  // Who leads and who keeps TODAY. Captain and keeper were already per-match;
  // vice-captain was not, so the trio could only be completed from the player's
  // standing record. All three change from match to match.
  isCaptain     Boolean @default(false)
  isViceCaptain Boolean @default(false)
  isWk          Boolean @default(false)
  match         Match   @relation(fields: [matchId], references: [id])
  player        Player  @relation(fields: [playerId], references: [id])
  team          Team    @relation(fields: [teamId], references: [id])

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([teamId])
}

model Inning {
  id              String  @id @default(cuid())
  matchId         String
  targetScore     Int?
  inningNumber    Int
  battingTeamId   String
  bowlingTeamId   String
  totalRuns       Int     @default(0)
  totalWickets    Int     @default(0)
  extras          Json?
  totalOvers      Float   @default(0)
  currentBowlerId String?
  nonStrikerId    String?
  strikerId       String?
  battingTeam     Team    @relation("battingTeam", fields: [battingTeamId], references: [id])
  bowlingTeam     Team    @relation("bowlingTeam", fields: [bowlingTeamId], references: [id])
  match           Match   @relation(fields: [matchId], references: [id])
  oversData       Over[]

  @@unique([matchId, inningNumber])
}

model Over {
  id         String @id @default(cuid())
  inningId   String
  overNumber Int
  bowlerId   String
  runs       Int    @default(0)
  extras     Int    @default(0)
  wickets    Int    @default(0)
  balls      Ball[]
  bowler     Player @relation(fields: [bowlerId], references: [id])
  inning     Inning @relation(fields: [inningId], references: [id])

  @@unique([inningId, overNumber])
  @@index([bowlerId])
}

model Ball {
  id                String            @id @default(cuid())
  overId            String
  ballNumber        Int
  batterId          String
  nonStrikerId      String
  runs              Int               @default(0)
  extras            Int               @default(0)
  extraType         String?
  isWicket          Boolean           @default(false)
  wicketType        String?
  wicketAssists     String?
  // Was the run out a direct hit? CricHeroes pay a run-out fielder full MVP
  // points "if it is a direct hit", and nothing recorded whether it was.
  // Nullable on purpose: null is "not recorded" (every ball before this), which
  // is not the same as false.
  directHit         Boolean?
  // Who put down a catchable chance off this delivery. Not a wicket, not a
  // CricHeroes concept — a fielding record their algorithm has no place for,
  // kept because in amateur cricket the drops are half the story.
  droppedBy         String?
  // Was it a sitter or a screamer? The scorer's call, recorded because "dropped"
  // on its own tells a spectator nothing — a shelled dolly and a fingertip
  // chance are not the same event.
  dropDifficulty    String?
  dismissedPlayerId String?
  clientEventId     String?           @unique
  bowlerId          String?
  batter            Player            @relation("facingBatter", fields: [batterId], references: [id])
  bowler            Player?           @relation("ballBowler", fields: [bowlerId], references: [id])
  nonStriker        Player            @relation("nonStriker", fields: [nonStrikerId], references: [id])
  over              Over              @relation(fields: [overId], references: [id])
  intelligence      BallIntelligence?

  @@index([overId])
  @@index([batterId])
  @@index([bowlerId])
  @@index([dismissedPlayerId])
}

/// Where the ball went, and how it was hit.
///
/// A SEPARATE table on purpose, not columns on Ball. Ball is the hot path — every
/// live-state rebuild, scorecard and career aggregation reads it, several with
/// explicit `select`s — and this is optional analytics that most matches will
/// never record. Keeping it out of the row means an untracked match pays nothing
/// for the feature existing, and a shot can be corrected or deleted without ever
/// touching the delivery that scored the runs.
///
/// One row per delivery (`ballId` unique). Cascade on delete so undoing a ball
/// takes its shot with it and cannot leave an orphan pointing at nothing.
model BallIntelligence {
  id     String @id @default(cuid())
  ballId String @unique

  /// Absolute direction the ball travelled: 0° straight down the ground past the
  /// bowler, increasing clockwise from above. NOT relative to the batter's off
  /// side — see backend/src/lib/ballIntelligence.js for why, and for the arcs.
  shotAngle    Float
  /// Derived from shotAngle by the server, never trusted from the client, so the
  /// angle and the name can never disagree with each other in the dataset.
  shotZone     String
  /// Percent of the way to the boundary. Null = the scorer gave a direction only.
  shotDistance Int?

  shotType       String?
  /// Derived from the delivery's own runs/wicket, so it cannot contradict the score.
  shotOutcome    String?
  connectionType String?

  /// Was it hit in the air? An ATTRIBUTE of the stroke, not a stroke of its own:
  /// a lofted cover drive is `shotType=coverDrive, lofted=true`, never a separate
  /// `loftedCoverDrive` type. Duplicating the taxonomy by trajectory would split
  /// every batter's cover-drive sample in two and leave neither big enough to say
  /// anything. Null means not recorded, which is not the same as false.
  lofted Boolean?

  /// Where the shot the scorer actually chose sat in the ranked list they were
  /// shown. Rank 1 means the engine led with the right answer; rank 19 means it
  /// did not. Stored because it is the only part of the ranking that cannot be
  /// recomputed later — the ordering itself is derivable from the delivery, the
  /// location and the rules, but what the scorer did when faced with it is not.
  /// This is the feedback that lets the weights improve without guesswork.
  selectedShotRank     Int?
  /// Which rules produced that rank, so a rank recorded under v1 is never read
  /// as evidence about v2.
  rankingEngineVersion Int?

  /// A written line for this delivery, generated ONCE for the handful of moments
  /// worth spending a model call on. Stored rather than generated on read
  /// because a read happens every six seconds for every spectator, and calling a
  /// model on each of those would be the exact thing this feature is designed
  /// not to do. Null for the overwhelming majority of balls, which get a
  /// template line composed on read instead (lib/shotCommentary.js).
  aiCommentary String?

  /// How this was captured — SCORER today; AI/VIDEO/IMPORTED/INFERRED later.
  /// Recorded from the first row so a future model's output is separable from a
  /// human's without a backfill that has to guess which was which.
  source     String @default("SCORER")
  confidence Float  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ball Ball @relation(fields: [ballId], references: [id], onDelete: Cascade)

  @@index([shotZone])
  @@index([shotType])
}

/// Where an external set of statistics came from, and what we may do with it.
///
/// This exists so that comparing a club player against a professional benchmark
/// is a matter of loading a licensed feed, not of writing a scraper. Nothing in
/// this app fetches anybody's data: rows arrive from a source somebody has the
/// right to use, and `licenceNote` is where that right is written down, next to
/// the data, where the next person will actually read it.
model PlayerStatSource {
  id          String   @id @default(cuid())
  /// Stable machine key — 'manual', or whichever provider is licensed.
  key         String   @unique
  name        String
  /// What this source permits. Deliberately free text and deliberately required
  /// reading before anyone builds on a source they did not add.
  licenceNote String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stats     ExternalPlayerStat[]
  shotStats ExternalPlayerShotStat[]
}

/// A benchmark player's headline batting figures, at some level of the game.
///
/// `playerId` is nullable because a benchmark exists whether or not anyone in
/// this app has been matched to it — the link is made later, by hand or by a
/// matcher, and an unmatched row is still useful as a level-wide average.
model ExternalPlayerStat {
  id               String  @id @default(cuid())
  sourceId         String
  /// The provider's own id, so a re-import updates rather than duplicates.
  externalPlayerId String?
  /// Our player, once somebody is confident they are the same person.
  playerId         String?
  /// As the provider spells it, which is not always as we do.
  playerName       String
  /// 'international' | 'domestic' | 'franchise' — free text so a new tier does
  /// not need a migration.
  level            String
  format           String?

  matches    Int?
  innings    Int?
  runs       Int?
  balls      Int?
  average    Float?
  strikeRate Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source PlayerStatSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalPlayerId, level, format])
  @@index([playerId])
  @@index([level])
}

/// The same, split by shot and zone — the shape this app's own dataset takes.
///
/// Kept separate from ExternalPlayerStat because shot-level data is far rarer
/// and far more expensive than headline figures: a source may licence one and
/// not the other, and a table that demanded both would refuse the common case.
model ExternalPlayerShotStat {
  id               String  @id @default(cuid())
  sourceId         String
  externalPlayerId String?
  playerId         String?
  level            String
  /// Our own vocabulary — see lib/ballIntelligence.js. An importer's job is to
  /// map a provider's names onto these, so comparisons are like for like.
  shotType         String?
  shotZone         String?

  balls      Int
  runs       Int
  strikeRate Float?
  dismissals Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source PlayerStatSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalPlayerId, level, shotType, shotZone])
  @@index([playerId])
  @@index([shotType])
  @@index([shotZone])
}

model News {
  id        String   @id @default(cuid())
  // Each sport is its own world in this app — content is scoped to one.
  sport     String   @default("cricket")
  createdAt DateTime @default(now())
  title     String
  summary   String
  body      String
  author    String?
  category  String?

  @@index([sport])
}

model Product {
  id          String   @id @default(cuid())
  // Each sport is its own world in this app — content is scoped to one.
  sport       String   @default("cricket")
  createdAt   DateTime @default(now())
  title       String
  description String
  price       Int
  category    String
  location    String?
  sellerId    String
  images      Json?
  seller      User     @relation(fields: [sellerId], references: [id])

  @@index([sport])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Pincode {
  id       Int    @id @default(autoincrement())
  office   String
  pincode  String
  district String
  state    String

  @@index([office])
  @@index([pincode])
  @@index([pincode], map: "pincode_pin_prefix_idx")
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  caption   String?
  userId    String?
  teamId    String?
  matchId   String?

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([matchId])
}

model Badge {
  id          String      @id @default(cuid())
  title       String
  description String
  icon        String?
  points      Int         @default(0)
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

// A tournament's identity and the handful of fields that lists, cards and
// filters actually read — plus its configuration, grouped.
//
// The configuration is deliberately NOT forty columns. docs/TOURNAMENT_DESIGN.md
// §1.4: a boolean column per rule means a migration every time a rule is added
// and nowhere to carry a rule's value (how many powerplay overs, what penalty).
// The Json blocks below are grouped on exactly the boundaries the doc gives to
// TournamentSettings / TournamentRegistration / TournamentRule /
// TournamentPointsRule / TournamentPrize, so promoting any one of them to its
// own table later is a data move rather than a redesign. Nothing queries or
// sorts by their contents; the moment something needs to, that block is the one
// to promote.
model Tournament {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now())
  name         String
  shortName    String?
  format       String
  category     String? // League / Knockout / League + Knockout / Round Robin / …
  status       String
  startDate    DateTime?
  endDate      DateTime?
  venue        String?
  city         String?
  maxTeams     Int?
  prizePool    String?
  description  String?
  organizer    String?
  sport        String                  @default("cricket")
  ballType     String?
  overs        Int?
  championId   String?
  organizerId  String?
  // The create screen has uploaded these since it was written; there were no
  // columns to put them in, and the create route's schema silently dropped
  // them, so every logo and banner anyone picked was discarded on save.
  logoUrl      String?
  banner       String?
  // Grouped configuration. See the note above.
  contact      Json? // organiser phone / email / website / whatsapp
  location     Json? // ground, address, state, country
  regWindow    Json? // registration opens/closes, first-match time, time zone
  registration Json? // squad limits, playing XI, entry fee, currency, how teams get in
  rules        Json? // wide/no-ball/free-hit/… toggles + powerplay & bowler quotas
  pointsRules  Json? // points per outcome, bonus point, tie-break order
  prizes       Json? // winner / runner-up / semi-finalist
  flags        Json? // visibility, live score, spectators
  // How the uploaded images should be DRAWN, as opposed to what they are.
  // { bannerFocus: { x, y } } — 0..1 across the image, the point that must stay
  // visible when a wide cover is cropped into a short card. Presentation, not
  // content, and a second image or a logo crop belongs here too rather than as
  // another pair of columns.
  media        Json?
  matches      TournamentMatch[]
  teams        TournamentTeam[]
  participants TournamentParticipant[]

  @@index([sport])
}

model Stream {
  id          String   @id @default(cuid())
  // Each sport is its own world in this app — content is scoped to one.
  sport       String   @default("cricket")
  title       String
  description String?
  matchId     String?
  channel     String
  isPrivate   Boolean  @default(false)
  quality     String
  status      String   @default("upcoming")
  createdAt   DateTime @default(now())

  @@index([sport])
}

model Ground {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  name           String
  localName      String?
  description    String?
  category       String? // "Cricket ground", "Sports complex", etc.
  groundType     String   @default("outdoor") // indoor | outdoor | box_cricket | stadium | nets | academy
  playingSurface String? // turf | grass | mat | concrete | synthetic | clay
  ballTypes      Json? // ["leather", "tennis", "soft"]

  // Address
  address       String?
  street        String?
  area          String?
  city          String?
  district      String?
  state         String?
  country       String  @default("IN")
  postalCode    String?
  latitude      Float?
  longitude     Float?
  googlePlaceId String? @unique
  googleMapsUrl String?

  // Contact
  phone    String?
  whatsapp String?
  email    String?
  website  String?

  // Ratings
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  // Flags
  bookingEnabled    Boolean @default(false)
  verified          Boolean @default(false)
  featured          Boolean @default(false)
  permanentlyClosed Boolean @default(false)
  temporarilyClosed Boolean @default(false)

  // Ownership & admin
  ownerId         String?
  submittedById   String?
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  adminNotes      String?
  // PENDING_VERIFICATION | APPROVED | REJECTED | NEEDS_CHANGES | SUSPENDED (plus legacy pending|published|rejected)
  status          String    @default("PENDING_VERIFICATION")
  sport           String    @default("cricket")

  // Legacy compat (existing Ground had these)
  location   String?
  price      Int?
  available  Boolean       @default(true)
  facilities Json?
  sports     GroundSport[]

  // Relations
  images        GroundImage[]
  openingHours  GroundOpeningHours[]
  amenities     GroundAmenity[]
  reviews       GroundReview[]
  favourites    GroundFavourite[]
  availability  GroundAvailability[]
  bookings      Booking[]
  verifications GroundVerification[]

  @@index([sport])
  @@index([city])
  @@index([state])
  @@index([status])
  @@index([groundType])
  @@index([verified])
  @@index([latitude, longitude])
  @@index([submittedById])
}

model GroundVerification {
  id        String   @id @default(cuid())
  groundId  String
  adminId   String?
  action    String // SUBMITTED, APPROVED, REJECTED, CHANGES_REQUESTED, SUSPENDED, REACTIVATED
  reason    String?
  notes     String?
  createdAt DateTime @default(now())

